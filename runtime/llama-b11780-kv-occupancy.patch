+bool llama_memory_kv_cell_counts(llama_memory_t mem, uint64_t * used, uint64_t * capacity) {
+    if (!used || !capacity) {
+        return false;
+    }
+    *used = *capacity = 0;
+    const auto * cache = dynamic_cast<const llama_kv_cache *>(mem);
+    if (!cache) {
+        return false;
+    }
+    std::set<uint32_t> streams;
+    for (uint32_t seq = 0; seq < cache->get_n_seq_max(); ++seq) {
+        if (streams.insert(cache->get_stream(seq)).second) {
+            const auto & cells = cache->get_cells(seq);
+            *used += cells.get_used();
+            *capacity += cells.size();
+        }
+    }
+    return *capacity > 0;
+}
