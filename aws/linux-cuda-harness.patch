diff -ru a/harness/memory.py b/harness/memory.py
--- a/harness/memory.py	2026-10-28 21:21:11.770404824 -0700
+++ b/harness/memory.py	2026-10-28 21:21:11.771876883 -0700
@@ -1,4 +1,4 @@
-"""Per-process memory measurement on macOS.
+"""Per-process memory measurement on macOS (and Linux + NVIDIA, see below).
 
 `phys_footprint` is what Activity Monitor reports as "Memory" and what the kernel uses for memory-pressure
 accounting. Unlike RSS it includes Metal (GPU) allocations in unified memory and excludes clean file-backed pages.
@@ -36,6 +36,24 @@
 
 _libproc = ctypes.CDLL("/usr/lib/libproc.dylib") if sys.platform == "darwin" else None
 
+# Linux + CUDA: the KV cache and weights live in VRAM, which RSS does not see. Footprint = RSS + VRAM used by
+# the process (NVML), the closest equivalent of macOS phys_footprint on unified memory.
+try:
+    import pynvml
+    pynvml.nvmlInit()
+    _nvml = [pynvml.nvmlDeviceGetHandleByIndex(i) for i in range(pynvml.nvmlDeviceGetCount())]
+except Exception:
+    _nvml = None
+
+
+def _gpu_bytes(pid: int) -> int:
+    total = 0
+    for h in _nvml or []:
+        for p in pynvml.nvmlDeviceGetComputeRunningProcesses(h):
+            if p.pid == pid and p.usedGpuMemory:
+                total += p.usedGpuMemory
+    return total
+
 MiB = 1024 * 1024
 
 
@@ -45,12 +63,14 @@
     footprint: int         # bytes
     peak_footprint: int    # bytes, kernel-tracked lifetime max
     rss: int               # bytes
+    gpu: int = 0           # bytes of VRAM (Linux + NVIDIA only)
 
 
 def sample(pid: int) -> MemSample:
     rss = psutil.Process(pid).memory_info().rss
     if _libproc is None:
-        return MemSample(time.monotonic(), rss, rss, rss)
+        gpu = _gpu_bytes(pid)
+        return MemSample(time.monotonic(), rss + gpu, rss + gpu, rss, gpu)
     info = _RusageInfoV4()
     if _libproc.proc_pid_rusage(pid, _RUSAGE_INFO_V4, ctypes.byref(info)) != 0:
         raise OSError(f"proc_pid_rusage failed for pid {pid}")
